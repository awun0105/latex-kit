% \begin{lkcode}[Python]{Training loop}  ...  \end{lkcode}
%   1st (optional) argument: language; 2nd: title (may be empty).
%   Extra tcolorbox keys: \begin{lkcode}[Python][label=lst:train]{Title}
\NewTCBListing[auto counter]{lkcode}{O{Python} O{} m}{%
  enhanced, breakable, colback=lkcodebg, colframe=black!15, boxrule=0.5pt, arc=2pt,
  left=18pt, right=4pt, top=2pt, bottom=2pt,
  listing only, listing engine=\lk@codeengine,
  lk@lang=#1,
  lk@title={#3},
  #2}

% \lkcodefile[Python][tcolorbox keys]{code/train.py}{optional title}
\NewDocumentCommand{\lkcodefile}{O{Python} O{} m G{}}{%
  \tcbinputlisting{enhanced, breakable, colback=lkcodebg, colframe=black!15, boxrule=0.5pt,
    arc=2pt, left=18pt, right=4pt, top=2pt, bottom=2pt, listing only,
    listing engine=\lk@codeengine, listing file={#3},
    lk@lang=#1,
    lk@titlestyle,
    title={\small\ttfamily\detokenize{#3}\ifstrempty{#4}{}{\ \textsf{\bfseries--\ #4}}},
    #2}}

% \begin{lkterminal} $ pip install torch \end{lkterminal}  — dark terminal box
\NewTCBListing{lkterminal}{!O{}}{%
  enhanced, breakable, colback=black!85, colframe=black!85, arc=2pt, boxrule=0pt,
  left=6pt, top=3pt, bottom=3pt, listing only, listing engine=listings,
  listing options={language=bash, basicstyle=\ttfamily\small\color{white},
    keywordstyle=\color{white}, commentstyle=\color{black!35}\itshape,
    stringstyle=\color{otyellow!80}, numbers=none},
  #1}
\ifcsname ver@latexkit-diagram.sty\endcsname\else\input{latexkit-opentikz-colors.tex}\fi

% \lkfile{path/to/file.py}: a file name in running text
\newcommand{\lkfile}[1]{\texttt{\detokenize{#1}}}

\endinput
