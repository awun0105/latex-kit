\fi

% \begin{lkcode}[Python]{Training loop}  ...  \end{lkcode}
%   1st (optional) argument: language; 2nd: title (may be empty).
%   Extra tcolorbox keys: \begin{lkcode}[Python][label=lst:train]{Title}
\NewTCBListing[auto counter]{lkcode}{O{Python} O{} m}{%
  enhanced, breakable, lk@box,
  left=18pt, right=4pt, top=2pt, bottom=2pt,
  listing only, listing engine=\lk@codeengine,
  lk@lang=#1,
  lk@title={#3},
  #2}

% \lkcodefile[Python][tcolorbox keys]{code/train.py}{optional title}
\NewDocumentCommand{\lkcodefile}{O{Python} O{} m G{}}{%
  \tcbinputlisting{enhanced, breakable, lk@box, left=18pt, right=4pt, top=2pt, bottom=2pt, listing only,
    listing engine=\lk@codeengine, listing file={#3},
    lk@lang=#1,
    lk@titlestyle,
    title={\small\ttfamily\detokenize{#3}\ifstrempty{#4}{}{\ \textsf{\bfseries--\ #4}}},
    #2}}

% \begin{lkterminal} $ pip install torch \end{lkterminal}  — dark terminal box
% \begin{lkterminal}[title=Cài đặt] ... \end{lkterminal}  — with a title bar
\colorlet{lk@termbg}{black!85}\colorlet{lk@termfg}{white}\colorlet{lk@termcm}{black!35}
\iflk@guide\colorlet{lk@termbg}{lkgterm}\colorlet{lk@termfg}{lkgtermfg}\colorlet{lk@termcm}{lkgtermcm}\fi
\NewTCBListing{lkterminal}{!O{}}{%
  enhanced, breakable, colback=lk@termbg, colframe=lk@termbg, arc=3pt, boxrule=0pt,
  colbacktitle=accent, coltitle=white, fonttitle=\sffamily\bfseries\small,
  toptitle=2pt, bottomtitle=2pt,
  left=6pt, top=3pt, bottom=3pt, listing only, listing engine=listings,
  listing options={language=bash, basicstyle=\ttfamily\small\color{lk@termfg},
    keywordstyle=\color{lk@termfg}, commentstyle=\color{lk@termcm},
    stringstyle=\color{lk@termfg}, numbers=none},
  #1}

% \begin{lkprompt}{Prompt kiểm tra kết quả} ... \end{lkprompt}
%   text sent to an AI agent or a chatbot: gray panel, accent title bar, the prompt
%   in a framed white box with line numbers. Optional first argument: tcolorbox keys.
\NewTCBListing{lkprompt}{O{} m}{%
  enhanced, breakable, colback=black!5, colframe=black!35, boxrule=0.6pt, arc=3pt,
  colbacktitle=accent, coltitle=white, fonttitle=\sffamily\bfseries\small,
  toptitle=2pt, bottomtitle=2pt, title={#2},
  left=6pt, right=6pt, top=5pt, bottom=5pt, listing only, listing engine=listings,
  listing options={basicstyle=\ttfamily\footnotesize, numbers=left,
    numberstyle=\tiny\color{black!45}, numbersep=5pt, frame=single, framerule=0.7pt,
    rulecolor=\color{black}, backgroundcolor=\color{white}, xleftmargin=14pt,
    framexleftmargin=12pt, framesep=4pt, breaklines=true, columns=fullflexible,
    keywordstyle={}, commentstyle={}, stringstyle={}},
  #1}
\ifcsname ver@latexkit-diagram.sty\endcsname\else\input{latexkit-opentikz-colors.tex}\fi

% \lkfile{path/to/file.py}: a file name in running text
\newcommand{\lkfile}[1]{\texttt{\detokenize{#1}}}

\endinput
