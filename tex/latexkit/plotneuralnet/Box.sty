% latexkit: macro names prefixed with \pnn (\pnnFill, \pnnCaption ...) so the
% layers no longer overwrite \fill, \caption, \name and \scale of the document.
\ProvidesPackage{Box}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% This Block can draw simple block of boxes with custom colors. 
% Can be used for conv, deconv etc
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\tikzset{Box/.pic={\tikzset{/boxblock/.cd,#1}
        \tikzstyle{box}=[every edge/.append style={pic actions, densely dashed, opacity=.7},fill opacity=\pnnOpacity, pic actions,fill=\pnnFill]
        
        \pgfmathsetmacro{\y}{\pnnCubey*\pnnScale}
        \pgfmathsetmacro{\z}{\pnnCubez*\pnnScale}
   
        %Multiple concatenated boxes
        \foreach[count=\i,%
                 evaluate=\i as \xlabel using {array({\pnnBoxlabels},\i-1)},% 
                 evaluate=\unscaledx as \k using {\unscaledx*\pnnScale+\prev}, remember=\k as \prev (initially 0)] 
                 \unscaledx in \pnnCubex
        {
            \pgfmathsetmacro{\x}{\unscaledx*\pnnScale}
            \coordinate (a) at (\k-\x , \y/2 , \z/2); 
            \coordinate (b) at (\k-\x ,-\y/2 , \z/2); 
            \coordinate (c) at (\k    ,-\y/2 , \z/2); 
            \coordinate (d) at (\k    , \y/2 , \z/2); 
            \coordinate (e) at (\k    , \y/2 ,-\z/2); 
            \coordinate (f) at (\k    ,-\y/2 ,-\z/2); 
            \coordinate (g) at (\k-\x ,-\y/2 ,-\z/2); 
            \coordinate (h) at (\k-\x , \y/2 ,-\z/2); 
        
            \draw [box] 
                (d) -- (a) -- (b) -- (c) -- cycle     
                (d) -- (a) -- (h) -- (e) -- cycle
                %dotted edges
                (f) edge (g)
                (b) edge (g)
                (h) edge (g)    
            ;
            \path (b) edge ["\xlabel"',midway] (c);
            
            \xdef\LastEastx{\k} %\k persists as \LastEastx after loop 
        }%Loop ends
        \draw [box] (d) -- (e) -- (f) -- (c) -- cycle; %East face of last box     
        
        \coordinate (a1) at (0 , \y/2 , \z/2);
        \coordinate (b1) at (0 ,-\y/2 , \z/2);
        \tikzstyle{depthlabel}=[pos=0,text width=14*\z,text centered,sloped]       
        
        \path (c) edge ["\small\pnnZlabel"',depthlabel](f); %depth label
        \path (b1) edge ["\pnnYlabel",midway] (a1);  %height label
        
        
        \tikzstyle{captionlabel}=[text width=15*\LastEastx/\pnnScale,text centered]       
        \path (\LastEastx/2,-\y/2,+\z/2) + (0,-25pt) coordinate (cap) 
        edge ["\textcolor{black}{ \bf \pnnCaption}"',captionlabel](cap) ; %Block caption/pic object label
         
        %Define nodes to be used outside on the pic object
        \coordinate (\pnnName-west)   at (0,0,0) ;
        \coordinate (\pnnName-east)   at (\LastEastx, 0,0) ;
        \coordinate (\pnnName-north)  at (\LastEastx/2,\y/2,0);
        \coordinate (\pnnName-south)  at (\LastEastx/2,-\y/2,0);       
        \coordinate (\pnnName-anchor) at (\LastEastx/2, 0,0) ;
        
        \coordinate (\pnnName-near) at (\LastEastx/2,0,\z/2);
        \coordinate (\pnnName-far)  at (\LastEastx/2,0,-\z/2);       
        
        \coordinate (\pnnName-nearwest) at (0,0,\z/2);
        \coordinate (\pnnName-neareast) at (\LastEastx,0,\z/2);
        \coordinate (\pnnName-farwest)  at (0,0,-\z/2);
        \coordinate (\pnnName-fareast)  at (\LastEastx,0,-\z/2);
        
        \coordinate (\pnnName-northeast) at (\pnnName-north-|\pnnName-east);
        \coordinate (\pnnName-northwest) at (\pnnName-north-|\pnnName-west);
        \coordinate (\pnnName-southeast) at (\pnnName-south-|\pnnName-east);
        \coordinate (\pnnName-southwest) at (\pnnName-south-|\pnnName-west);
        
        \coordinate (\pnnName-nearnortheast)  at (\LastEastx, \y/2, \z/2);
        \coordinate (\pnnName-farnortheast)   at (\LastEastx, \y/2,-\z/2);
        \coordinate (\pnnName-nearsoutheast)  at (\LastEastx,-\y/2, \z/2);
        \coordinate (\pnnName-farsoutheast)   at (\LastEastx,-\y/2,-\z/2);
        
        \coordinate (\pnnName-nearnorthwest)  at (0, \y/2, \z/2);
        \coordinate (\pnnName-farnorthwest)   at (0, \y/2,-\z/2);
        \coordinate (\pnnName-nearsouthwest)  at (0,-\y/2, \z/2);
        \coordinate (\pnnName-farsouthwest)   at (0,-\y/2,-\z/2);
        
    },
    /boxblock/.search also={/tikz},
    /boxblock/.cd,
    width/.store        in=\pnnCubex,
    height/.store       in=\pnnCubey,
    depth/.store        in=\pnnCubez,
    scale/.store        in=\pnnScale,
    xlabel/.store       in=\pnnBoxlabels,
    ylabel/.store       in=\pnnYlabel,
    zlabel/.store       in=\pnnZlabel,
    caption/.store      in=\pnnCaption,
    name/.store         in=\pnnName,
    fill/.store         in=\pnnFill,
    opacity/.store      in=\pnnOpacity,
    fill={rgb:red,5;green,5;blue,5;white,15},
    opacity=0.4,
    width=2,
    height=13,
    depth=15,
    scale=.2,
    xlabel={{"","","","","","","","","",""}},
    ylabel=,
    zlabel=,
    caption=,
    name=,
}
