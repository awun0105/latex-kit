% latexkit-math.sty — math packages, theorem environments, common macros.
\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{latexkit-math}[2026/11/08 v0.1 latexkit math]

\RequirePackage{amsmath, amssymb, mathtools, bm}
\iflk@beamer\else
  \RequirePackage{amsthm}
  \iflk@chapters
    \newtheorem{theorem}{\lkstr{Định lý}{Theorem}}[chapter]
  \else
    \newtheorem{theorem}{\lkstr{Định lý}{Theorem}}[section]
  \fi
  \newtheorem{lemma}[theorem]{\lkstr{Bổ đề}{Lemma}}
  \newtheorem{proposition}[theorem]{\lkstr{Mệnh đề}{Proposition}}
  \newtheorem{corollary}[theorem]{\lkstr{Hệ quả}{Corollary}}
  \theoremstyle{definition}
  \newtheorem{definition}[theorem]{\lkstr{Định nghĩa}{Definition}}
  \newtheorem{example}[theorem]{\lkstr{Ví dụ}{Example}}
  \theoremstyle{remark}
  \newtheorem*{remark}{\lkstr{Nhận xét}{Remark}}
  \iflk@vi\renewcommand{\proofname}{Chứng minh}\fi
\fi

\providecommand{\R}{\mathbb{R}}
\providecommand{\N}{\mathbb{N}}
\providecommand{\Z}{\mathbb{Z}}
\providecommand{\E}{\mathbb{E}}
\providecommand{\Prob}{\mathbb{P}}
\DeclareMathOperator*{\argmin}{arg\,min}
\DeclareMathOperator*{\argmax}{arg\,max}
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}
\newcommand{\vect}[1]{\bm{#1}}
\newcommand{\mat}[1]{\mathbf{#1}}
\newcommand{\T}{^{\mkern-1.5mu\mathsf{T}}}
\newcommand{\dd}{\,\mathrm{d}}

\endinput
