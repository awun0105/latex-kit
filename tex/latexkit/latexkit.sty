% ---------------------------------------------------------------- bibliography
\ifdefstring{\lk@bib}{natbib}{%
  \RequirePackage[numbers,sort&compress]{natbib}
  \newcommand{\lkbibliography}{\bibliographystyle{plainnat}\bibliography{\lk@bibfile}}}{}
\ifdefstring{\lk@bib}{biblatex}{%
  \RequirePackage[backend=biber,style=numeric-comp,sorting=none,natbib=true]{biblatex}
  \addbibresource{\lk@bibfile.bib}
  \newcommand{\lkbibliography}{\printbibliography}}{}
\ifdefstring{\lk@bib}{none}{\newcommand{\lkbibliography}{}}{}

% ---------------------------------------------------------------- links (load last)
\iflk@beamer
  \hypersetup{colorlinks=true, linkcolor=., urlcolor=accent, citecolor=accent}
\else
  \RequirePackage[colorlinks=true,linkcolor=accent,citecolor=accent,urlcolor=accent]{hyperref}
\fi
\RequirePackage[capitalise,noabbrev]{cleveref}
\iflk@vi
  \crefname{figure}{Hình}{Hình}        \Crefname{figure}{Hình}{Hình}
  \crefname{table}{Bảng}{Bảng}         \Crefname{table}{Bảng}{Bảng}
  \crefname{equation}{Công thức}{Công thức} \Crefname{equation}{Công thức}{Công thức}
  \crefname{section}{Mục}{Mục}         \Crefname{section}{Mục}{Mục}
  \crefname{subsection}{Mục}{Mục}      \Crefname{subsection}{Mục}{Mục}
  \crefname{chapter}{Chương}{Chương}   \Crefname{chapter}{Chương}{Chương}
  \crefname{appendix}{Phụ lục}{Phụ lục}\Crefname{appendix}{Phụ lục}{Phụ lục}
  \crefname{listing}{Đoạn code}{Đoạn code}\Crefname{listing}{Đoạn code}{Đoạn code}
  \crefname{lstlisting}{Đoạn code}{Đoạn code}\Crefname{lstlisting}{Đoạn code}{Đoạn code}
  \crefname{algorithm}{Thuật toán}{Thuật toán}\Crefname{algorithm}{Thuật toán}{Thuật toán}
  \crefname{theorem}{Định lý}{Định lý} \Crefname{theorem}{Định lý}{Định lý}
  \crefname{lemma}{Bổ đề}{Bổ đề}       \Crefname{lemma}{Bổ đề}{Bổ đề}
  \crefname{definition}{Định nghĩa}{Định nghĩa}\Crefname{definition}{Định nghĩa}{Định nghĩa}
  \crefname{tcb@cnt@lkcode}{Đoạn code}{Đoạn code}\Crefname{tcb@cnt@lkcode}{Đoạn code}{Đoạn code}
\else
  \crefname{tcb@cnt@lkcode}{Listing}{Listings}\Crefname{tcb@cnt@lkcode}{Listing}{Listings}
\fi

