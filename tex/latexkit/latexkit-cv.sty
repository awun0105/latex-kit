% latexkit-cv.sty — one-column CV and letter layout (ATS friendly: plain text order,
% no icons, no layout tables except one tabularx row per entry).
%   \cvheader{Name}{Headline}{item 1, item 2, \href{https://...}{site}}
%   \letterheader{Name}{item 1, item 2, ...}        gray band across the top
%   \cvsection{Title}
%   \cventry{Title}{Place}{Subtitle}{Date}  then  \begin{cvitems} \item ... \end{cvitems}
%   \cvproject{Name}{Tools}{Date}
%   \cvskill{Label}{list}
\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{latexkit-cv}[2026/11/08 v0.1 latexkit CV and letter]

\RequirePackage{tabularx}
\RequirePackage{enumitem}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{needspace}

\providecolor{lkgray}{HTML}{4B5563}
\colorlet{cvrule}{black!70}
\colorlet{cvband}{black!8}

% "a, b, c" -> "a | b | c"
\newcommand{\lkcv@sep}{\quad\textbar\quad}
\newcommand{\lkcv@list}[1]{%
  \def\lkcv@first{1}%
  \foreach \lkcv@it in {#1}{%
    \ifnum\lkcv@first=1 \gdef\lkcv@first{0}\else\lkcv@sep\fi
    \lkcv@it}}

% ---------------------------------------------------------------- CV
\newcommand{\cvheader}[3]{%
  \begin{center}
    {\Huge\bfseries #1}\par\vspace{4pt}
    {\small #2}\par\vspace{4pt}
    {\small\lkcv@list{#3}}
  \end{center}\vspace{-4pt}}

\newcommand{\cvsection}[1]{%
  \par\Needspace{4\baselineskip}\vspace{9pt}%
  {\large\scshape #1}\par\vspace{-6pt}%
  {\color{cvrule}\rule{\linewidth}{0.5pt}}\par\vspace{2pt}}

\newcommand{\cventry}[4]{%
  \par\Needspace{3\baselineskip}\vspace{3pt}%
  \noindent\begin{tabularx}{\linewidth}[t]{@{}X@{\hspace{1em}}r@{}}
    \textbf{#1} & \small #2 \\
    \ifblank{#3#4}{}{\textit{\small #3} & \textit{\small #4} \\}
  \end{tabularx}\par}

\newcommand{\cvproject}[3]{%
  \par\Needspace{3\baselineskip}\vspace{3pt}%
  \noindent\begin{tabularx}{\linewidth}[t]{@{}X@{\hspace{1em}}r@{}}
    \textbf{#1}\ifblank{#2}{}{\enspace\textbar\enspace\textit{\small #2}} & \small #3 \\
  \end{tabularx}\par}

\newenvironment{cvitems}
  {\begin{itemize}[leftmargin=1.4em, topsep=2pt, itemsep=1pt, parsep=0pt,
                   label=\textbullet, font=\small]\small}
  {\end{itemize}}

\newcommand{\cvskill}[2]{\par\noindent{\small\textbf{#1:} #2}\par\vspace{2pt}}

% ---------------------------------------------------------------- letter
% Gray band across the full page width, name in small caps, contact row below.
\newcommand{\letterheader}[2]{%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[cvband] (current page.north west) rectangle
      ([yshift=-3.1cm]current page.north east);
  \end{tikzpicture}%
  \vspace*{-1.2cm}
  \begin{center}
    {\fontsize{26}{30}\selectfont\scshape #1}\par\vspace{1.1cm}
    {\small\lkcv@list{#2}}
  \end{center}\vspace{6pt}}

\endinput
