# D2 architecture diagram. Docs: https://d2lang.com
# Used in the document with \lkdiagram{diagrams/architecture}
direction: right
classes: {
  svc: { style: { fill: "#E9EEF5"; stroke: "#1F4E79"; border-radius: 4 } }
  store: { shape: cylinder; style: { fill: "#F2F5F9"; stroke: "#4B5563" } }
}
client: Người dùng { shape: person }
api: API { class: svc }
worker: Worker { class: svc }
db: Database { class: store }
queue: Queue { shape: queue }
client -> api: HTTP
api -> queue: gửi job
queue -> worker
worker -> db: ghi
api -> db: đọc
